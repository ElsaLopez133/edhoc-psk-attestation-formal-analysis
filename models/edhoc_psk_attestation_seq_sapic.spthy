/*
 * Protocol:   Remote Attestation for EDHOC-PSK
 * Source: https://www.ietf.org/archive/id/draft-ietf-lake-ra-05.html

 Scenarios to check ideally:
 - `tamarin-prover -D=LeakShare`
 - `tamarin-prover -D=LeakSKey`
*/

theory edhoc_psk_ra_sapic

begin

builtins: diffie-hellman, hashing, xor, signing

functions:
  method_four/0, length/0,
  hash_length/0, key_length/0, iv_length/0, plaintext_length/0, aead_length/0,
  edhoc_kdf/4,
  aeadenc/4, aeaddec/4 [destructor],
  wrap/1,
  pk/1, id_att/2, get_meas/1 [destructor], get_att_key/1 [destructor], // for attestation materials
  hash/1, hkdfextract/2, hkdfexpand/2,
  encxor/2, decxor/2 [destructor],
  // Credential modeling functions
  make_id/3,           // make_id(cred_i, cred_r, psk) -> ID_CRED_PSK
  get_cred/3 [destructor] 

equations:
  aeaddec(aeadenc(m,k,r,ad),k,r,ad) = m,
  decxor(encxor(m,k),k) = m,
  get_cred(make_id(credI, credR, psk), psk, credR) = credI,
  get_meas(id_att(x,y))=x,
	get_att_key(id_att(x,y))=y

#include "Headers.splib"

heuristic:s

/* -------------------- Initiator -------------------- */
let I(~cid, method, ~credI, ~psk, credR, ~akI, ~measurement, ID_CRED_Att_resultR) =
  in(<suitesI,C_I,EAD_1>);
  event MethodOk(method);

  let CRED_I = ~credI in  
  let CRED_R = credR in
  let ID_CRED_PSK = make_id(CRED_I, CRED_R, ~psk) in
  // identity for attestation
  let ID_CRED_Att = id_att(hash(~measurement), pk(~akI)) in

  new ~X;
  event Share(~X);

  // We check that we are not talking to oursevles
  if CRED_I = CRED_R then(
    0
  ) else
  (
    CompromiseShare(~X) |
    event InitiateWithID(CRED_I, CRED_R);
    event StartI(~cid, method, CRED_I, CRED_R, ~psk);

    let G_X = 'g'^~X in
    let m1 = <method,suitesI,G_X,C_I,EAD_1> in
    out(m1);

    in(m2);
    event ReceivedRData(~cid, method, CRED_I, CRED_R, ~psk, ~X, m2);

    let < G_Y, CIPHERTEXT_2 > = m2 in
    let TH_1 = hash(<wrap(method), wrap(suitesI), wrap(G_X), wrap(C_I), EAD_1>) in
    let TH_2 = hash(<wrap(G_Y), wrap(TH_1)>) in

    let G_YX = G_Y^~X in
    let PRK_2e = hkdfextract(TH_2, G_YX) in
    let KEYSTREAM_2A = edhoc_kdf(PRK_2e,'tzero',TH_2,plaintext_length) in
    let plaintext_2 = decxor(CIPHERTEXT_2, KEYSTREAM_2A) in
    // EAD_2 contains the nonce generated by the responder
    let < C_R, EAD_2> = plaintext_2 in
    let <nonceR_in, =ID_CRED_Att_resultR> = EAD_2 in
    let measurement_hash = hash(~measurement) in
    if method = method_four() then (
        let PRK_3e2m = PRK_2e in
        event DerivedIShared(G_YX);

        let TH_3 = hash(<wrap(TH_2), plaintext_2>) in
        let SALT_4e3m = edhoc_kdf(PRK_3e2m, 'five', TH_3, hash_length) in
        let PRK_4e3m = hkdfextract(~psk, SALT_4e3m) in

        let KEYSTREAM_3A = edhoc_kdf(PRK_3e2m, 'eleven', TH_3, plaintext_length) in
        let K_3 = edhoc_kdf(PRK_4e3m, 'twelve', TH_3, key_length) in
        let IV_3 = edhoc_kdf(PRK_3e2m, 'thirteen', TH_3, iv_length) in

        let external_aad_3 = <ID_CRED_PSK, TH_3, CRED_I, CRED_R> in
        let ad_3 = <'Encrypt0','empty',external_aad_3> in

        // Construction of EAD_3
        new ~nonceI;
				event HonestNonceI(~nonceI);
        // attestation binder
        let H_12 = hash(hash(m1), m2) in
				let attest_info = <H_12, 'attestation', CRED_I> in
				let attestation_binder_m3 = hkdfexpand('salt', attest_info) in

        let signature = sign(<'Signature1',ID_CRED_Att, nonceR_in, measurement_hash, attestation_binder_m3>, ~akI) in
        let EAD_3 = <ID_CRED_Att, nonceR_in, signature, ~nonceI> in
        event AttestationGeneratedI(~cid, CRED_I, CRED_R, nonceR_in, signature, ~psk, ~akI, ~X, G_YX, pk(~akI));

        let plaintext_3b = <EAD_3> in
        let ciphertext_3b = aeadenc(plaintext_3b, K_3, IV_3, ad_3) in
        let plaintext_3a = <ID_CRED_PSK, ciphertext_3b> in
        let m3 = encxor(plaintext_3a, KEYSTREAM_3A) in

        let TH_4 = hash(<wrap(TH_3), ID_CRED_PSK, plaintext_3b, CRED_I, CRED_R>) in
        let K_4 = edhoc_kdf(PRK_4e3m,'eight', TH_4, key_length) in
        let IV_4 = edhoc_kdf(PRK_3e2m,'nine', TH_4, iv_length) in
        let PRK_out = edhoc_kdf(PRK_4e3m,'seven', TH_4, hash_length) in
        event DerivedI(~cid, method, CRED_I, CRED_R, PRK_out, ~X, G_Y, ~psk, ~akI, G_YX);
        event ExplicitDerivedI(~cid, method, CRED_I, CRED_R, PRK_out, ~X, G_Y, ~psk, G_YX);
        event SentByI(~cid, CRED_I, CRED_R, nonceR_in, signature, G_YX, G_X, G_Y, TH_3, ~akI, pk(~akI), ID_CRED_Att, ~psk);
        out(m3);      
          (
            in(m4);
            let external_aad_4 = <TH_4> in
            let ad_4 = <'Encrypt0','empty',external_aad_4> in
            let plaintext_4 = aeaddec(m4, K_4, IV_4, ad_4) in
            let EAD_4 = plaintext_4 in
            let <=ID_CRED_Att_resultR, nonceI_in, value_in, signature_in> = EAD_4 in
            let pk_attkey_v = get_att_key(ID_CRED_Att_resultR) in
						if verify (signature_in, <ID_CRED_Att_resultR, nonceI_in, value_in>, pk_attkey_v) = true then(
							event VerifiedSignatureI(~cid, CRED_I, CRED_R, nonceI_in, signature_in, ~X, G_YX, pk_attkey_v);
							if ~nonceI = nonceI_in then (
								event VerifiedNonceI(~cid, CRED_I, CRED_R, signature_in, nonceI_in, ~X, G_YX, pk_attkey_v);
								event FinishI(~cid, CRED_I, CRED_R, G_YX, ~X, G_X, G_Y, nonceI_in, nonceR_in, signature, signature_in, measurement_hash, ID_CRED_Att, ID_CRED_Att_resultR, ~psk, pk(~akI), pk_attkey_v);
								0
								)
            )
            |
            (
              0
              |
              leakSKey(PRK_out)
            )
          )
      ) else (0)
  )

/* -------------------- Responder -------------------- */
let R(~cid, ~credR, ~psk, ID_CRED_Att, ~value, ~akV) =
  // in(<C_R,EAD_2,suitesR>);
  in(<C_R,suitesR>);
  in(m1);
  let <method,suitesI,G_X,C_I,EAD_1> = m1 in
  event MethodOk(method);

  let CRED_R = ~credR in
  new ~Y;
  event Share(~Y);

  (
    CompromiseShare(~Y) |
    event RespondWithID(CRED_R);
    event StartR(~cid, CRED_R, ~psk);

    let G_Y = 'g'^~Y in
    let G_XY = G_X^~Y in
    // identity for attestation
	  let ID_CRED_Att_result = id_att(~value, pk(~akV)) in 
    let TH_1 = hash(<wrap(method), wrap(suitesI), wrap(G_X), wrap(C_I), EAD_1>) in
    let TH_2 = hash(<wrap(G_Y), wrap(TH_1)>) in
    let PRK_2e = hkdfextract(TH_2, G_XY) in

    if method = method_four() then (
      new ~nonceR;
      event HonestNonce(~nonceR);
      let EAD_2 = <~nonceR, ID_CRED_Att_result> in
      let plaintext_2 = <C_R, EAD_2> in
      let KEYSTREAM_2A = edhoc_kdf(PRK_2e,'tzero', TH_2, plaintext_length) in
      event THRShared(TH_2);
      event DerivedRShared(G_XY);

      let m2 = <G_Y, encxor(plaintext_2, KEYSTREAM_2A)> in
      event SendRData(~cid, method, CRED_R, ~psk, m2);							    
      out(m2);

      in(m3);

      let TH_3 = hash(<wrap(TH_2), plaintext_2>) in
      let PRK_3e2m = PRK_2e in
      let KEYSTREAM_3 = edhoc_kdf(PRK_3e2m,'eleven', TH_3, plaintext_length) in
      let plaintext_3a = decxor(m3, KEYSTREAM_3) in
      let <ID_CRED_PSK_in, ciphertext_3b> = plaintext_3a in
      let CRED_I = get_cred(ID_CRED_PSK_in, ~psk, CRED_R) in

      if CRED_I = CRED_R then (
        0
      ) else 
      
      (
        let SALT_4e3m = edhoc_kdf(PRK_3e2m,'five', TH_3, hash_length) in
        let PRK_4e3m = hkdfextract(~psk, SALT_4e3m) in
        let K_3 = edhoc_kdf(PRK_4e3m,'twelve', TH_3, key_length) in
        let IV_3 = edhoc_kdf(PRK_3e2m,'thirteen', TH_3, iv_length) in

        let external_aad_3 = <ID_CRED_PSK_in, TH_3, CRED_I, CRED_R> in
        let ad_3 = <'Encrypt0','empty',external_aad_3> in
        let plaintext_3b = aeaddec(ciphertext_3b, K_3, IV_3, ad_3) in
        let EAD_3 = plaintext_3b in

        // Verify EAD_3
        let <=ID_CRED_Att, nonceR_in, signature_in, nonceI_in> = EAD_3 in
        let measurement_hash_R = get_meas(ID_CRED_Att) in
        let pk_attkey_I = get_att_key(ID_CRED_Att) in
        let H_12 = hash(hash(m1), m2) in
				let attest_info = <H_12, 'attestation', CRED_I> in
				let attestation_binder_m3 = hkdfexpand('salt', attest_info) in
        if verify(signature_in, <'Signature1',ID_CRED_Att, nonceR_in, measurement_hash_R, attestation_binder_m3>, pk_attkey_I) = true then (
            event VerifiedSignatureR(~cid, ID_CRED_Att, CRED_R, nonceR_in, signature_in, ~psk, ~Y, G_XY, pk_attkey_I);
            if ~nonceR = nonceR_in then (
              event VerifiedNonceR(~cid, CRED_I, CRED_R, signature_in, nonceR_in, ~psk, ~Y, G_XY, pk_attkey_I);
              event AttestationAcceptedR(~cid, CRED_I, CRED_R, nonceR_in, signature_in, G_XY, G_X, G_Y, TH_3, pk_attkey_I, ID_CRED_Att, ~psk);
              let signatureR = sign(<ID_CRED_Att_result, nonceI_in, ~value>, ~akV) in
						  event ResultGeneratedR(~cid, CRED_I, CRED_R, nonceI_in, signatureR, ~psk, ~akV, ~Y, G_XY, pk(~akV));
						  let EAD_4 = <ID_CRED_Att_result, nonceI_in, ~value, signatureR> in
						
              let TH_4 = hash(<wrap(TH_3), ID_CRED_PSK_in, plaintext_3b, CRED_I, CRED_R>) in
              let K_4 = edhoc_kdf(PRK_4e3m,'eight', TH_4, key_length) in
              let IV_4 = edhoc_kdf(PRK_3e2m,'nine', TH_4, iv_length) in
              let PRK_out = edhoc_kdf(PRK_4e3m,'seven', TH_4, hash_length) in
              let external_aad_4 = <TH_4> in
              let ad_4 = <'Encrypt0','empty',external_aad_4> in
              let m4 = aeadenc(EAD_4, K_4, IV_4, ad_4) in
              event DerivedR(~cid,PRK_out,~Y,G_X, ~psk);
              event AcceptR(~cid, method, CRED_I, CRED_R, PRK_out, G_X, ~Y, ~psk, G_XY);
              event SessionR(~cid, CRED_I, CRED_R, PRK_out, G_XY);
              event AcceptRData(PRK_out, method, CRED_I, CRED_R, ~psk,~Y,G_X,<TH_2,TH_3,TH_4,suitesI, EAD_1, EAD_2, EAD_3, m1, plaintext_2, plaintext_3a>);
              event FinishR(~cid, CRED_I, CRED_R, G_XY, ~Y, G_X, G_Y, nonceI_in, nonceR_in, signature_in, signatureR, measurement_hash_R, ID_CRED_Att, ID_CRED_Att_result, ~psk, pk_attkey_I, pk(~akV));
              out(m4);
              (
                  0 
                  |
                  leakSKey(PRK_out)
              )
            ) 
          )        
      ) 
    ) else (0)
  )

/* -------------------- Main Process -------------------- */
let compromise(psk) =
    in('Comp'); event Compromise(psk); event SharePSK(psk); out(psk)

let LeakAttKey(ak) =
    in('Comp'); event LeakAttKey(ak); out(ak)

process:
  !(new ~psk; 
    event Honest(~psk);

    !
    ( 
      new ~cid; new ~cred; new ~akI; new ~measurement; new ~akV; new ~value;
      event HonestSubject(~cred);
      event HonestAttKey(~akI);
      out(~cred);
      let idd_att = id_att(hash(~measurement), pk(~akI)) in
      let idd_att_result = id_att( ~value, pk(~akV)) in
      ( ( !in(credR); I(~cid, method_four(), ~cred, ~psk, credR, ~akI, ~measurement, idd_att_result))
        |
        (!R(~cid, ~cred, ~psk, idd_att, ~value, ~akV))
        |
        (compromise(~psk))
        |
        (LeakAttKey(~akI))
        |
        (LeakAttKey(~akV))
      )
    )
  )


#include "LAKERAPropertiesPSK.splib"

end
