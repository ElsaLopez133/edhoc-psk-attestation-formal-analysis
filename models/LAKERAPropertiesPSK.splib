
// ******************************************************************
// ************** Reachability   ************************************
// ******************************************************************

#ifdef SanityChecks

/* there exists at least one initiator AcceptI */
lemma exists_acceptI[output=[proverif]]:
  exists-trace
  "Ex cid m idI prk x gy credI credR psk #t.
    AcceptI(cid, idI, m, credI, credR, prk, x, gy, psk) @ t"

/* there exists at least one responder AcceptR */
lemma exists_acceptR[output=[proverif]]:
  exists-trace
  "Ex cid idR m prk gx y credI credR psk #t.
    AcceptR(cid, idR, m, credI, credR, prk, gx, y, psk) @ t"

#endif

// ******************************************************************
// ****Full Agreement: Authentication and key confirmation***********
// ******************************************************************

// Mutual Authentication (non-injective)
// If a Responder accepted a session, i.e., it finished, then there must 
// be a Initiator that has already derived the same values (same prk), 
// unless PSK and subjects were leaked, in which case the attacker can forge
// a session as an Initiator

// PASSED
lemma MutualAuthenticationRI:
  "All cid m credI  credR  prk gx y psk gxy #i #j #k #l.
     AcceptR(cid, m, credI, credR, prk, gx, y, psk, gxy)@i
     & 
     Honest(psk)@j 
     &
     HonestSubject(credR)@k 
     &
     HonestSubject(credI)@l 
   ==> (Ex cidI gy x ak #t. DerivedI(cidI, m, credI, credR, prk, x, gy, psk, ak, gxy)@t & t < i)
    | 
    (Ex #t. Compromise(psk)@t)
    "   

// PASSED
lemma MutualAuthenticationIR:
  "All cid m credI  credR  prk x  gy psk ak gxy #i #j #k #l.
     AcceptI(cid, m, credI, credR, prk, x, gy, psk, ak, gxy)@i
     & 
     Honest(psk)@j 
     &
     HonestSubject(credR)@k 
     &
     HonestSubject(credI)@l 
   ==> (Ex cidR y gx #t. AcceptR(cidR, m, credI, credR, prk, gx, y, psk, gxy)@t & t < i)
    | 
    (Ex #t. Compromise(psk)@t)
    "   

// Injectivity of the Agreement from Responder to Initiator
lemma InjectiveAgreementRI:
  "All cid1 cid2 m credI credR prk gx1 gx2 y1 y2 psk gxy1 gxy2 #i #j #k #l.
     AcceptR(cid1, m, credI, credR, prk, gx1, y1, psk, gxy1)@i
     &
     AcceptR(cid2, m, credI, credR, prk, gx2, y2, psk, gxy2)@j
     &
     Honest(psk)@k
     &
     HonestSubject(credR)@l
   ==> 
    (#i = #j)
    "

lemma InjectiveAgreementIR:
  "All cid1 cid2 m credI credR prk x1 x2 gy1 gy2 psk gxy1 gxy2 ak1 ak2 #i #j #k #l.
     AcceptI(cid1, m, credI, credR, prk, x1, gy1, psk, ak1, gxy1)@i
     &
     AcceptI(cid2, m, credI, credR, prk, x2, gy2, psk, ak2, gxy2)@j
     &
     Honest(psk)@k
     &
     HonestSubject(credR)@l
   ==> 
    (#i = #j)
    "

// ******************************************************************
// ***************** Attestation ************************************
// ******************************************************************

// Attestation freshness 
// PASSED
lemma AttestationEvidenceFreshness:
  "All credI1 credI2 credR1 credR2 nonce meas1 meas2 sig1 sig2 cid1 cid2 psk1 psk2 pk_attkey1 pk_attkey2 y1 y2 gxy1 gxy2 #i #j #k.
    AttestationAcceptedR(cid1, credI1, credR1, sig1, nonce, meas1, psk1, y1, gxy1, pk_attkey1)@i
    &
    AttestationAcceptedR(cid2, credI2, credR2, sig2, nonce, meas2, psk2, y2, gxy2, pk_attkey2)@j
    &
    HonestNonce(nonce)@k
  ==> 
  (#i = #j)
  &
  (#k < #i)
  "


// Attestation integrity -> the evidence is not modified, so signature is correct
// PASSED
lemma AttestationEvidenceIntegrity:
  "All m credI credR sig nonce meas cidR psk ak x y gx gxy pk_attkey prk #i #j #k #l.
    VerifiedSignatureR(cidR, credI, credR, nonce, meas, sig, psk, y, gxy)@i    
    &
    HonestSubject(credI)@j
    &
    HonestSubject(credR)@l
    &
    Honest(psk)@k
  ==> 
  (Ex cidI ak x #t. AttestationGeneratedI(cidI, credI, credR, nonce, meas, sig, psk, ak, x, gxy)@t & t < i)
  |
  (Ex #t. LeakAttKey(ak)@t)
  |
  (Ex #t. Compromise(psk)@t)
  "


  // Agreement of parameters for attestation and authentication
// TODO
lemma AgreementParamaters:
  "All cid credI  credR  prk psk gxy y nonce sig pk_attkey #i #j #k #l #u.
     FinishR(cid, credI, credR, prk, psk, gxy,y, nonce, sig, pk_attkey)@i
     & 
     Honest(psk)@j 
     &
     HonestSubject(credR)@k 
     &
     HonestSubject(credI)@l 
   ==> (Ex ak x #t #u. SentByI(cid, credI, credR, prk, psk, gxy, x, nonce, sig, ak, pk_attkey)@t & t < i 
   & HonestAttKey(ak)@u)
    | 
    (Ex #t. Compromise(psk)@t)
    "   

