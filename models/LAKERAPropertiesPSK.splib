// Attestation freshness 
// PASSED
lemma AttestationEvidenceFreshnessv1:
  "All credI1 credI2 credR1 credR2 nonce meas1 meas2 sig1 sig2 cid1 cid2 psk1 psk2 pk_attkey1 pk_attkey2 y1 y2 gxy1 gxy2 #i #j.
    AttestationAcceptedR(cid1, credI1, credR1, sig1, nonce, meas1, psk1, y1, gxy1, pk_attkey1)@i
    &
    AttestationAcceptedR(cid2, credI2, credR2, sig2, nonce, meas2, psk2, y2, gxy2, pk_attkey2)@j
  ==> 
  (#i = #j)
  "


// Attestation integrity -> the evidence is not modified, so signature is correct
// PASSED
lemma AttestationEvidenceIntegrity:
  "All m credI credR nonce meas sig cid psk ak x y gx gxy pk_attkey prk #i #j #k #l #u #n.
    AttestationGeneratedI(cid, credI, credR, nonce, meas, sig, psk, ak, x, gxy)@i
    &
    AcceptR(cid, m, credI, credR, prk, gx, y, psk, gxy)@n
    &
    HonestSubject(credI)@j
    &
    HonestSubject(credR)@l
    &
    Honest(psk)@k
  ==> 
  // (Ex #t. AttestationAcceptedR(cid, credI, credR, sig, nonce, meas, psk, y, gxy, pk_attkey)@t)
  (Ex #t. VerifiedSignatureR(cid, credI, credR, sig, psk, y, gxy)@t)
  |
  (Ex #t. LeakAttKey(ak)@t)
  |
  (Ex #t. Compromise(psk)@t)
  "

