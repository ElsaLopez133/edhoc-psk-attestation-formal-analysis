
// ******************************************************************
// ************** Reachability   ************************************
// ******************************************************************

#ifdef SanityChecks

/* there exists at least one initiator AcceptI */
lemma exists_acceptI[output=[proverif]]:
  exists-trace
  "Ex cid m credI credR prk x gy psk akI gxy #t.
    AcceptI(cid, m, credI, credR, prk, x, gy, psk, akI, gxy) @ t"

lemma exists_startI[output=[proverif]]:
  exists-trace
  "Ex cid m credI credR psk #t.
    StartI(cid,m,credI,credR,psk) @ t"

    /* there exists at least one responder AcceptR */
lemma exists_acceptR[output=[proverif]]:
  exists-trace
  "Ex cid m credI credR prk gx y psk gxy #t.
    AcceptR(cid,m, credI, credR, prk, gx, y, psk, gxy) @ t"

lemma exists_startR[output=[proverif]]:
  exists-trace
  "Ex cid credR psk #t.
    StartR(cid,credR,psk) @ t"
#endif


// ******************************************************************
// ****Full Agreement: Authentication and key confirmation***********
// ******************************************************************

// Mutual Authentication (non-injective)
// If a Responder accepted a session, i.e., it finished, then there must 
// be a Initiator that has already derived the same values (same prk), 
// unless PSK and subjects were leaked, in which case the attacker can forge
// a session as an Initiator

