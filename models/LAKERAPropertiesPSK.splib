// ******************************************************************
// ****Full Agreement: Authentication and key confirmation***********
// ******************************************************************

// Authentication of the Initiator to the Responder
// If a Responder accepted a session, i.e., it finished, then there must 
// be a Initiator that derived the same values (same prk), 
// unless PSK and subjects were leaked, in which case the attacker can forge
// a session as an Initiator

// This lemma proves uniqueness and mutual authentication. So, if there are two sessions
// of R, with the same prk and psk, then they must be the same session AND and Initiator must
// have enageged in a session, unless the PSK or subjects were leaked
// If this happens, then the attacker could play the role of I and there would not
// be an Initiator running in the session.

// lemma full_agreement_RI:
//   "All cid1 cid2 m credI1 credI2 credR1 credR2 prk gx1 gx2 y1 y2 psk ak gxy1 gxy2 #i #j #k #l #c.
//      AcceptR(cid1, m, credI1, credR1, prk, gx1, y1, psk, gxy1)@i
//      & 
//      AcceptR(cid2, m, credI2, credR2, prk, gx2, y2, psk, gxy2)@j
//      & 
//      Honest(psk)@k 
//      & 
//      HonestSubject(credI1)@l 
//      &
//      HonestSubject(credI2)@c
//    ==> (Ex cid credI credR x gy prk gxy #t.
//           DerivedI(cid, m, credI, credR, prk, x, gy, psk, ak, gxy)@t & t < i & t < j 
//           & cid1 = cid2 & gx1 = gx2 & y1 = y2 & credI1 = credI2 & credR1 = credR2 
//           & credI = credI1 & credR = credR1 & gxy1 = gxy2 & gxy1 = gxy & #i = #j)
//     | 
//     (Ex #t. Compromise(psk)@t & t < j)
//     "     

// Authentication of the Responder to the Initiator
// If an Initiator accepted a session, i.e., it finished, then there must 
// be a Responder that has already completed the protocol with the same prk, 
// unless PSK and subjects were leaked, in which case the attacker can forge
// a session as a Repsonder

// lemma full_agreement_IR:
//   "All cid1 cid2 m credI1 credI2 credR1 credR2 prk x1 x2 gy1 gy2 psk ak1 ak2 gxy1 gxy2 #i #j #k #l #c.
//      AcceptI(cid1, m, credI1, credR1, prk, x1, gy1, psk, ak1, gxy1)@i
//      & 
//      AcceptI(cid2, m, credI2, credR2, prk, x2, gy2, psk, ak2, gxy2)@j
//      & 
//      Honest(psk)@k 
//      &
//      HonestSubject(credR1)@l 
//      & 
//      HonestSubject(credR2)@c
//    ==> (Ex cid credI credR gx y prk gxy #t.
//           AcceptR(cid, m, credI, credR, prk, gx, y, psk, gxy)@t & t < i & t < j 
//           & cid1 = cid2 & x1 = x2 & gy1 = gy2 & credI1 = credI2 & credR1 = credR2 
//           & credI = credI1 & credR = credR1 & ak1 = ak2 & gxy1 = gxy2 & gxy1 = gxy & #i = #j)
//     | 
//     (Ex #t. Compromise(psk)@t & t < j)
//     "   

// Mutual Authentication (non-injective)
// If a Responder accepted a session, i.e., it finished, then there must 
// be a Initiator that has already derived the same values (same prk), 
// unless PSK and subjects were leaked, in which case the attacker can forge
// a session as an Initiator

// PASSED
lemma MutualAuthenticationRI:
  "All cid m credI  credR  prk gx y psk gxy #i #j #k #l.
     AcceptR(cid, m, credI, credR, prk, gx, y, psk, gxy)@i
     & 
     Honest(psk)@j 
     &
     HonestSubject(credR)@k 
     &
     HonestSubject(credI)@l 
   ==> (Ex cidI gy x ak #t. DerivedI(cidI, m, credI, credR, prk, x, gy, psk, ak, gxy)@t & t < i)
    | 
    (Ex #t. Compromise(psk)@t)

    "   
// PASSED
lemma MutualAuthenticationIR:
  "All cid m credI  credR  prk x  gy psk ak gxy #i #j #k #l.
     AcceptI(cid, m, credI, credR, prk, x, gy, psk, ak, gxy)@i
     & 
     Honest(psk)@j 
     &
     HonestSubject(credR)@k 
     &
     HonestSubject(credI)@l 
   ==> (Ex cidR y gx #t. AcceptR(cidR, m, credI, credR, prk, gx, y, psk, gxy)@t & t < i)
    | 
    (Ex #t. Compromise(psk)@t)
    "   

